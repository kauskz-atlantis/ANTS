#:kivy 2.3.0

<Topbar@BoxLayout>:
    orientation: "horizontal"
    size_hint_y: None
    height: "64dp"
    padding: "12dp", "8dp"
    spacing: "10dp"

    home_btn: home_btn
    
    canvas.before:
        Color:
            rgba: 0,0,0,1
        Rectangle:
            size: self.size
            pos: self.pos
    Image:
        source: "assets/images/logo_white.png"
        size_hint_x: None
        fit_mode: "contain"
    
    BoxLayout:
        orientation: "horizontal"
        spacing: 10

        Widget:

        RoundedBoxLayout:
            orientation: "horizontal"
            size_hint: None, None
            height: 48
            width: self.minimum_width
            spacing: 2
            padding: 4
            
            bg_color: app.background_color
            radius: self.height/4
            
            RoundedToggleButton:
                id: home_btn
                size_hint_x: None
                width: self.texture_size[0]
                radius: self.height/4
                text: "DASHBOARD"
                allow_no_selection: False
                group: "top"
                state: "down"
                on_release: app.switch("home")
            
            RoundedToggleButton:
                size_hint_x: None
                width: self.texture_size[0]
                radius: self.height/4
                text: "UPLOAD LOG"
                allow_no_selection: False
                group: "top"
                on_release: app.switch("project")
    
        Widget:

    RoundedHoverButton:
        size_hint_x: None
        text: "LOG OUT"
        bold: True
        on_release: app.root.sm.login.logout()